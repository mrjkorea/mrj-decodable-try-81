  "pages": [
    {
      "page_id": "p01",
      "text": "A laugh is not a word. It is air \u2014 rough puffs shoved out through your chest.",
      "image": "books/mlr_dec_099/pages/p01.webp",
      "audio": "books/mlr_dec_099/audio/pages/p01.mp3",
      "duration_ms": 6556,
      "voice": "57785406027844b29b63a772a8477bc2",
