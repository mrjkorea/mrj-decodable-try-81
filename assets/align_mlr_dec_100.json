      "song_duration_ms": 9586
    },
    {
      "page_id": "p03",
      "text": "Ling gets the job she wants: weigh eight boxes on the old freight scale.",
      "image": "books/mlr_dec_100/pages/p03.webp",
      "audio": "books/mlr_dec_100/audio/pages/p03.mp3",
      "duration_ms": 5825,
      "voice": "57785406027844b29b63a772a8477bc2",
