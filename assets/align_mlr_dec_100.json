    },
    {
      "page_id": "p02",
      "text": "A sign on the shed says no sleigh may weigh over two hundred pounds. Chen's pony hauls it.",
      "image": "books/mlr_dec_100/pages/p02.webp",
      "audio": "books/mlr_dec_100/audio/pages/p02.mp3",
