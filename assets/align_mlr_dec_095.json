      "song_audio": "books/mlr_dec_095/audio/song/p06.mp3",
      "song_duration_ms": 7497
    },
    {
      "page_id": "p07",
      "text": "Then the lights went dark. Every plug was dead. Eight musicians stood silent \u2014 no electricity, no action, no social!",
      "image": "books/mlr_dec_095/pages/p07.webp",
      "audio": "books/mlr_dec_095/audio/pages/p07.mp3",
      "duration_ms": 10997,
      "voice": "57785406027844b29b63a772a8477bc2",
