  "pages": [
    {
      "page_id": "p01",
      "text": "On Monday, Marco's mother turns thirty. He and his brother want to get her a gift.",
      "image": "books/mlr_dec_085/pages/p01.webp",
      "audio": "books/mlr_dec_085/audio/pages/p01.mp3",
      "duration_ms": 6556,
      "voice": "57785406027844b29b63a772a8477bc2",
      "has_video": false,
      "song_audio": "books/mlr_dec_085/audio/song/p01.mp3",
      "song_duration_ms": 8463
    },
    {
      "page_id": "p02",
      "text": "They tip out the money jar: a dozen coins and nothing more.",
      "image": "books/mlr_dec_085/pages/p02.webp",
      "audio": "books/mlr_dec_085/audio/pages/p02.mp3",
      "duration_ms": 5250,
      "voice": "57785406027844b29b63a772a8477bc2",
      "has_video": false,
      "song_audio": "books/mlr_dec_085/audio/song/p02.mp3",
      "song_duration_ms": 6739
    },
    {
      "page_id": "p03",
      "text": "His brother counts it again. \"This gets her nothing,\" he says. \"But we could make her an onion pie.\"",
      "image": "books/mlr_dec_085/pages/p03.webp",
      "audio": "books/mlr_dec_085/audio/pages/p03.mp3",
      "duration_ms": 7418,
      "voice": "57785406027844b29b63a772a8477bc2",
      "has_video": false,
      "song_audio": "books/mlr_dec_085/audio/song/p03.mp3",
      "song_duration_ms": 9639
    },
    {
      "page_id": "p04",
      "text": "Onion pie has won no prize. Nobody else will eat it. It is their mother's one true love.",
      "image": "books/mlr_dec_085/pages/p04.webp",
      "audio": "books/mlr_dec_085/audio/pages/p04.mp3",
      "duration_ms": 7079,
      "voice": "57785406027844b29b63a772a8477bc2",
      "has_video": false,
      "song_audio": "books/mlr_dec_085/audio/song/p04.mp3",
      "song_duration_ms": 9064
    },
    {
      "page_id": "p05",
      "text": "His brother cuts the onion. Marco sobs at the table. \"Onion tears,\" says his brother. \"They do not count.\"",
      "image": "books/mlr_dec_085/pages/p05.webp",
      "audio": "books/mlr_dec_085/audio/pages/p05.mp3",
      "duration_ms": 9142,
      "voice": "57785406027844b29b63a772a8477bc2",
      "has_video": false,
      "song_audio": "books/mlr_dec_085/audio/song/p05.mp3",
      "song_duration_ms": 10422
    },
    {
      "page_id": "p06",
      "text": "They cover the onion with honey. They cover the honey with a crust. Nothing about it looks good.",
      "image": "books/mlr_dec_085/pages/p06.webp",
      "audio": "books/mlr_dec_085/audio/pages/p06.mp3",
      "duration_ms": 6556,
      "voice": "57785406027844b29b63a772a8477bc2",
      "has_video": false,
      "song_audio": "books/mlr_dec_085/audio/song/p06.mp3",
      "song_duration_ms": 9404
    },
    {
      "page_id": "p07",
      "text": "The oven turns it brown. Marco lifts the pie out with a big oven glove.",
      "image": "books/mlr_dec_085/pages/p07.webp",
      "audio": "books/mlr_dec_085/audio/pages/p07.mp3",
      "duration_ms": 6556,
      "voice": "57785406027844b29b63a772a8477bc2",
      "has_video": false,
      "song_audio": "books/mlr_dec_085/audio/song/p07.mp3",
      "song_duration_ms": 7340
    },
    {
      "page_id": "p08",
      "text": "The pie is an odd color. They wonder if a mother can love it.",
      "image": "books/mlr_dec_085/pages/p08.webp",
      "audio": "books/mlr_dec_085/audio/pages/p08.mp3",
      "duration_ms": 5093,
      "voice": "57785406027844b29b63a772a8477bc2",
      "has_video": false,
      "song_audio": "books/mlr_dec_085/audio/song/p08.mp3",
      "song_duration_ms": 6687
    },
    {
      "page_id": "p09",
      "text": "The front door opens. \"Marco! My son!\" says his mother. \"What is that smell?\"",
      "image": "books/mlr_dec_085/pages/p09.webp",
      "audio": "books/mlr_dec_085/audio/pages/p09.mp3",
      "duration_ms": 8202,
      "voice": "57785406027844b29b63a772a8477bc2",
      "has_video": false,
      "song_audio": "books/mlr_dec_085/audio/song/p09.mp3",
      "song_duration_ms": 8515
    },
    {
      "page_id": "p10",
      "text": "She eats the lot and leaves them nothing. \"Best month of my life,\" she says. \"Make me another next month.\"",
      "image": "books/mlr_dec_085/pages/p10.webp",
      "audio": "books/mlr_dec_085/audio/pages/p10.mp3",
      "duration_ms": 8411,
      "voice": "57785406027844b29b63a772a8477bc2",
